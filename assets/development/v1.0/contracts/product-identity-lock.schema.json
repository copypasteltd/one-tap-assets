{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "identity_lock_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "photo_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "source_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "SHAPE",
              "PACKAGING",
              "QUANTITY",
              "COLOR",
              "TEXT_LOGO",
              "STRUCTURE",
              "ACCESSORY"
            ]
          },
          "value": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "minItems": 1,
            "maxItems": 30
          }
        },
        "required": [
          "kind",
          "value",
          "evidence_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      },
      "minItems": 0,
      "maxItems": 100
    },
    "canonicalization": {
      "const": "RFC8785"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "identity_lock_id",
    "tenant_id",
    "profile_id",
    "photo_version",
    "source_asset_ids",
    "features",
    "unknowns",
    "canonicalization",
    "content_hash"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "一品成片 product-identity-lock",
  "description": "内部开发设计合同，不含凭证或可长期访问的私有URL。跨字段/权限/事务另需语义验证。",
  "x-implementation-status": "DESIGN_NOT_IMPLEMENTED"
}
