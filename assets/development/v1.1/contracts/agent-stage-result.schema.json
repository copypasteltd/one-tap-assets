{
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "order_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "preview_session_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "role": {
      "$ref": "#/$defs/AgentRole"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_hash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "skill_bundle_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_asset_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "tool_receipt_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "checkpoint_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "type": "string",
      "enum": [
        "READY",
        "BLOCKED",
        "FAILED"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 0,
      "maxItems": 30
    }
  },
  "required": [
    "tenant_id",
    "order_id",
    "preview_session_id",
    "run_id",
    "role",
    "input_hash",
    "snapshot_hash",
    "skill_bundle_hash",
    "output_asset_ids",
    "tool_receipt_ids",
    "checkpoint_hash",
    "result",
    "reason_codes"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "order_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "preview_session_id": {
          "type": "null"
        }
      }
    },
    {
      "properties": {
        "order_id": {
          "type": "null"
        },
        "preview_session_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentStageResult",
  "x-implementation-status": "DESIGN_NOT_IMPLEMENTED",
  "$defs": {
    "AgentRole": {
      "type": "string",
      "enum": [
        "CONTENT",
        "PRODUCTION",
        "POST",
        "REVIEW_FACTS",
        "REVIEW_STYLE"
      ]
    }
  }
}
