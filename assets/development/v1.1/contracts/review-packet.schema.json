{
  "type": "object",
  "properties": {
    "packet_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "tenant_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "order_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "state": {
      "$ref": "#/$defs/ReviewPacketState"
    },
    "packet_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "identity_lock_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "skill_bundle_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "qc_policy_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "original_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "asset_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 3,
      "maxItems": 5
    },
    "evidence_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "asset_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 1000
    },
    "output_set_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "required_slot_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "slot_id",
          "asset_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 100
    },
    "production_run_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "production_thread_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "production_process_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      },
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true
    },
    "reports": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "report_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "tenant_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "order_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "thread_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "runtime_process_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "isolation_evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "role": {
            "type": "string",
            "enum": [
              "REVIEW_FACTS",
              "REVIEW_STYLE"
            ]
          },
          "packet_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "snapshot_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "output_set_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "INSUFFICIENT_EVIDENCE"
            ]
          },
          "evidence_complete": {
            "type": "boolean"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "category": {
                  "type": "string",
                  "enum": [
                    "PRODUCT",
                    "FACT",
                    "SPEC",
                    "AUDIO",
                    "CAPTION",
                    "STYLE",
                    "CONTINUITY",
                    "EVIDENCE"
                  ]
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "BLOCKER",
                    "MAJOR",
                    "MINOR"
                  ]
                },
                "evidence_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "minItems": 0,
                  "maxItems": 50
                },
                "time_ms": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                }
              },
              "required": [
                "category",
                "severity",
                "evidence_ids",
                "time_ms",
                "detail"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "maxItems": 100
          },
          "policy_version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        },
        "required": [
          "report_id",
          "tenant_id",
          "order_id",
          "run_id",
          "thread_id",
          "runtime_process_ref",
          "isolation_evidence_id",
          "role",
          "packet_hash",
          "snapshot_hash",
          "output_set_hash",
          "verdict",
          "evidence_complete",
          "findings",
          "policy_version"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 2
    },
    "deterministic_pass": {
      "type": "boolean"
    },
    "evidence_complete": {
      "type": "boolean"
    },
    "unknown_paid_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "publication_decision": {
      "type": "string",
      "enum": [
        "PENDING",
        "ALLOW",
        "BLOCK"
      ]
    }
  },
  "required": [
    "packet_id",
    "tenant_id",
    "order_id",
    "state",
    "packet_hash",
    "snapshot_hash",
    "identity_lock_hash",
    "skill_bundle_hash",
    "qc_policy_version",
    "original_assets",
    "evidence_assets",
    "output_set_hash",
    "required_slot_ids",
    "outputs",
    "production_run_ids",
    "production_thread_ids",
    "production_process_refs",
    "reports",
    "deterministic_pass",
    "evidence_complete",
    "unknown_paid_calls",
    "publication_decision"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewPacket",
  "x-implementation-status": "DESIGN_NOT_IMPLEMENTED",
  "$defs": {
    "ReviewPacketState": {
      "type": "string",
      "enum": [
        "SEALED",
        "REVIEWING",
        "PASSED",
        "STALE",
        "FAILED",
        "INSUFFICIENT_EVIDENCE"
      ]
    }
  }
}
