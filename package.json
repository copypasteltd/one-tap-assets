{
  "name": "ypcc-one-tap-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "contracts": "tsx scripts/generate-types.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "community:prepare": "node --env-file=.env.local --import tsx scripts/community-commercial.ts",
    "dev:api": "tsx watch src/api/main.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:reaper": "tsx watch src/worker/lifecycle/reaper-main.ts",
    "dev:media-maintenance": "tsx watch src/worker/lifecycle/media-maintenance-main.ts",
    "privacy:journal": "tsx src/worker/lifecycle/privacy-journal-main.ts",
    "dev:preview": "vite --config src/preview/vite.config.ts",
    "build:preview": "vite build --config src/preview/vite.config.ts",
    "build": "pnpm contracts && pnpm typecheck && pnpm build:server && pnpm build:preview && pnpm build:alipay && pnpm build:douyin",
    "build:server": "tsx scripts/build-server.ts",
    "build:alipay": "node scripts/build-mini.cjs alipay",
    "build:douyin": "node scripts/build-mini.cjs tt",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:ui": "tsx scripts/record-preview.ts",
    "docs:media": "tsx scripts/record-preview.ts",
    "docs:audio": "tsx scripts/record-native-audio.ts",
    "docs:disclosure": "tsx scripts/record-disclosure.ts",
    "docs:metrics": "tsx scripts/record-metrics.ts",
    "verify:implementation": "tsx scripts/verify-implementation.ts",
    "verify:publication": "tsx scripts/verify-publication.ts",
    "doctor": "tsx scripts/delivery/doctor.ts",
    "local:start": "tsx scripts/delivery/start.ts",
    "preview:serve": "tsx scripts/delivery/start.ts --preview-only",
    "delivery:build": "tsx scripts/delivery/build.ts",
    "delivery:package": "tsx scripts/delivery/package.ts",
    "start:api": "node runtime/build/api/main.js",
    "start:worker": "node runtime/build/worker/main.js",
    "start:reaper": "node runtime/build/worker/lifecycle/reaper-main.js",
    "start:media-maintenance": "node runtime/build/worker/lifecycle/media-maintenance-main.js",
    "start:privacy-journal": "node runtime/build/worker/lifecycle/privacy-journal-main.js",
    "verify:docs": "python -B -X utf8 scripts/核验Codex方案.py"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/rate-limit": "11.2.1",
    "@tarojs/components": "4.3.1",
    "@tarojs/helper": "4.3.1",
    "@tarojs/react": "4.3.1",
    "@tarojs/runtime": "4.3.1",
    "@tarojs/shared": "4.3.1",
    "@tarojs/taro": "4.3.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@playwright/test": "1.64.1",
    "@tarojs/cli": "4.3.1",
    "@tarojs/plugin-framework-react": "4.3.1",
    "@tarojs/plugin-platform-alipay": "4.3.1",
    "@tarojs/plugin-platform-tt": "4.3.1",
    "@tarojs/service": "4.3.1",
    "@tarojs/webpack5-runner": "4.3.1",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "babel-preset-taro": "4.3.1",
    "esbuild": "0.28.2",
    "openapi-typescript": "7.13.0",
    "postcss": "8.5.32",
    "selfsigned": "5.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "webpack": "5.91.0"
  }
}
