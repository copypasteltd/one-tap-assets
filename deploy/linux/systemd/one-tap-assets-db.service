[Unit]
Description=One Tap Assets private PostgreSQL 17
After=network.target
[Service]
Type=simple
User=ypccdb
Group=ypccdb
Environment=LD_LIBRARY_PATH=/opt/one-tap-assets/tools/pgsql/usr/lib/x86_64-linux-gnu
ExecStart=/opt/one-tap-assets/tools/pgsql/usr/lib/postgresql/17/bin/postgres -D /var/lib/one-tap-assets/postgres
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=120
RuntimeDirectory=one-tap-assets-db
RuntimeDirectoryMode=0755
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/one-tap-assets/postgres /run/one-tap-assets-db
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
CapabilityBoundingSet=
MemoryMax=4G
[Install]
WantedBy=multi-user.target
